{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japan Holiday Data — 年別祝日",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "year", "dataVersion", "holidays"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "year": {"type": "integer", "minimum": 1, "maximum": 9999},
    "dataVersion": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holidays": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
      "additionalProperties": {"type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$"}
    }
  }
}
