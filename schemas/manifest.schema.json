{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japan Holiday Data — Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "dataVersion", "minYear", "maxYear", "recordCount",
    "updatedAt", "checkedAt", "source", "sourceUrl", "yearVersions"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "dataVersion": {"$ref": "#/$defs/hash"},
    "minYear": {"type": "integer", "minimum": 1, "maximum": 9999},
    "maxYear": {"type": "integer", "minimum": 1, "maximum": 9999},
    "recordCount": {"type": "integer", "minimum": 1},
    "updatedAt": {"$ref": "#/$defs/jst"},
    "checkedAt": {"$ref": "#/$defs/jst"},
    "source": {"type": "string", "const": "内閣府"},
    "sourceUrl": {"type": "string", "format": "uri", "const": "https://www8.cao.go.jp/chosei/shukujitsu/syukujitsu.csv"},
    "yearVersions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?!0000)[0-9]{4}$"},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jst": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+09:00$"}
  }
}
